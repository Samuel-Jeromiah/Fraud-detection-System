# Base URL of the Fraud Detection FastAPI backend (no trailing slash).
#   Local dev:   http://localhost:8000
#   Production:  https://fraud-detection-api-fux4.onrender.com
#
# On Vercel, set this in Project Settings → Environment Variables (it is inlined
# into the client bundle at build time because of the NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_API_URL=https://fraud-detection-api-fux4.onrender.com
